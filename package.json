{
  "name": "myapps",
  "version": "1.3.4",
  "description": "My Apps",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Sarfraz",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "make-icons": "node scripts/make-icons.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^25.0.0"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.myapps.desktopapp",
    "productName": "My Apps",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload/**/*",
      "src/**/*",
      "assets/**/*",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MyApps-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "MyApps-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sarfraznawaz2005",
      "repo": "myapps",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9"
  }
}
